{
  "name": "הזמנות אוכל דגניה",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": {
        "hook": 4151586
      },
      "mapper": {},
      "metadata": {
        "designer": { "x": 0, "y": 0, "name": "הזמנה נכנסת" },
        "restore": {
          "parameters": {
            "hook": { "label": "הזמנה נכנסת" }
          }
        },
        "parameters": [
          { "name": "hook", "type": "hook:gateway-webhook", "label": "Webhook", "required": true }
        ]
      }
    },
    {
      "id": 2,
      "module": "builtin:BasicRouter",
      "version": 1,
      "mapper": null,
      "metadata": {
        "designer": { "x": 300, "y": 0, "name": "האם ההזמנה תקינה?" }
      },
      "routes": [
        {
          "flow": [
            {
              "id": 3,
              "module": "datastore:AddRecord",
              "version": 1,
              "filter": {
                "name": "הזמנה תקינה: שם, תאריך ומנה עיקרית",
                "conditions": [
                  [
                    { "a": "{{1.person}}", "o": "exist" },
                    { "a": "{{1.date}}", "o": "exist" },
                    { "a": "{{1.meat}}", "o": "exist" }
                  ],
                  [
                    { "a": "{{1.person}}", "o": "exist" },
                    { "a": "{{1.date}}", "o": "exist" },
                    { "a": "{{1.veg}}", "o": "exist" }
                  ]
                ]
              },
              "parameters": {
                "datastore": 267642
              },
              "mapper": {
                "key": "{{1.date}}_{{1.person}}",
                "overwrite": true,
                "data": {
                  "date": "{{1.date}}",
                  "person": "{{1.person}}",
                  "meat": "{{1.meat}}",
                  "veg": "{{1.veg}}",
                  "side1": "{{1.side1}}",
                  "side2": "{{1.side2}}",
                  "salad1": "{{1.salad1}}",
                  "salad2": "{{1.salad2}}"
                }
              },
              "metadata": {
                "designer": { "x": 600, "y": -150, "name": "שמירת ההזמנה" },
                "restore": {
                  "parameters": {
                    "datastore": { "label": "הזמנות אוכל דגניה" }
                  }
                }
              }
            },
            {
              "id": 5,
              "module": "gateway:WebhookRespond",
              "version": 1,
              "parameters": {},
              "mapper": {
                "status": 200,
                "body": "{\"ok\":true}"
              },
              "metadata": {
                "designer": { "x": 900, "y": -150, "name": "אישור שמירה" }
              }
            }
          ]
        },
        {
          "flow": [
            {
              "id": 4,
              "module": "gateway:WebhookRespond",
              "version": 1,
              "filter": {
                "name": "הזמנה לא תקינה",
                "conditions": [
                  [ { "a": "{{1.person}}", "o": "notexist" } ],
                  [ { "a": "{{1.date}}", "o": "notexist" } ],
                  [
                    { "a": "{{1.meat}}", "o": "notexist" },
                    { "a": "{{1.veg}}", "o": "notexist" }
                  ]
                ]
              },
              "parameters": {},
              "mapper": {
                "status": 400,
                "body": "{\"ok\":false,\"error\":\"חסר שם, תאריך או מנה עיקרית\"}"
              },
              "metadata": {
                "designer": { "x": 600, "y": 150, "name": "הודעת שגיאה" }
              }
            }
          ]
        }
      ]
    }
  ],
  "metadata": {
    "instant": true,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "slots": null,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "designer": { "orphans": [] },
    "zone": "eu1.make.com"
  }
}
